# Flask Configuration
SECRET_KEY=super-secret-key-change-in-production
FLASK_ENV=development
DEBUG=True
PORT=5000

# OpenWeatherMap API Key
# Sign up free at https://openweathermap.org/api to get your 32-character key
OPENWEATHER_API_KEY=your_openweathermap_api_key_here

# Database Configuration
# Default is SQLite for instant local execution
DATABASE_URL=sqlite:///weather_system.db

# For MySQL Database (AWS RDS / GCP Cloud SQL / Local MySQL):
# DATABASE_URL=mysql+pymysql://root:password@localhost:3306/weather_db
